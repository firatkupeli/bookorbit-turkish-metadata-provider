# Copy to .env for compose.synology.yaml, then fill both required values.
# Use an existing macvlan network and an unused IP inside its subnet, outside DHCP.
BOOKORBIT_NETWORK=
PROVIDER_IPV4_ADDRESS=
# Optional, only after a public GHCR image has been published.
PROVIDER_IMAGE=
AUTH_TOKEN=
USER_AGENT=BookOrbitTurkishMetadata/0.1.2
SOURCE_INTERVAL_SECONDS=2
REQUEST_TIMEOUT_SECONDS=5
DEADLINE_SECONDS=12
SEARCH_CACHE_TTL=900
BOOK_CACHE_TTL=86400
CACHE_MAX_BYTES=16777216
API_REQUESTS_PER_MINUTE=60
MAX_RESULTS=5
